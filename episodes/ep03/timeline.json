{
 "total": 141.4,
 "clips": [
  {
   "id": "N1",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    0.21,
    4.63
   ],
   "dst": 0.4,
   "dur": 4.42,
   "text": "Setelah malam itu, nggak ada satu pun dari kami yang bisa tidur.",
   "emo": "lelah"
  },
  {
   "id": "N2",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    5.25,
    11.94
   ],
   "dst": 5.22,
   "dur": 6.69,
   "text": "Paginya, Ibu Kos manggil kami bertiga ke rumahnya. Katanya... ada yang harus dia ceritain.",
   "emo": "cemas"
  },
  {
   "id": "I1",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    0.15,
    7.02
   ],
   "dst": 13.31,
   "dur": 6.87,
   "text": "Ibu minta maaf. Kemarin Ibu bohong. Ibu takut kalian pindah semua.",
   "emo": "sedih"
  },
  {
   "id": "I2",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    7.64,
    13.57
   ],
   "dst": 20.58,
   "dur": 5.93,
   "text": "Tujuh tahun lalu, kamar empat ditempati seorang perempuan. Namanya Melati.",
   "emo": "sedih"
  },
  {
   "id": "N3",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    12.42,
    14.63
   ],
   "dst": 26.81,
   "dur": 2.21,
   "text": "Melati? Kayak nama kos ini?",
   "emo": "kaget"
  },
  {
   "id": "I3",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    14.19,
    20.72
   ],
   "dst": 29.42,
   "dur": 6.53,
   "text": "Dia suka bunga melati. Suka jemur baju tengah malam. Dan lampu tidurnya... warna hijau.",
   "emo": "sedih"
  },
  {
   "id": "I4",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    21.4,
    27.72
   ],
   "dst": 36.45,
   "dur": 6.32,
   "text": "Suatu malam, dia hilang. Yang tersisa cuma baju putihnya... masih tergantung di jemuran.",
   "emo": "sedih"
  },
  {
   "id": "A1",
   "spk": "adel",
   "file": "audio/adel.mp3",
   "src": [
    0.0,
    3.3
   ],
   "dst": 43.57,
   "dur": 3.3,
   "text": "Bu, perempuan di foto ini... siapa?",
   "emo": "penasaran"
  },
  {
   "id": "I5",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    28.33,
    31.96
   ],
   "dst": 47.17,
   "dur": 3.63,
   "text": "Itu Melati. Foto terakhirnya, di depan kamarnya.",
   "emo": "sedih"
  },
  {
   "id": "N4",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    15.19,
    18.88
   ],
   "dst": 52.4,
   "dur": 3.69,
   "text": "Lampu di jendela itu... udah hijau dari tujuh tahun lalu.",
   "emo": "takut"
  },
  {
   "id": "I6",
   "spk": "ibukos",
   "file": "audio/ibukos.mp3",
   "src": [
    32.53,
    37.21
   ],
   "dst": 56.39,
   "dur": 4.68,
   "text": "Kalau mau tahu lebih banyak, tanya Pak RT. Dulu dia yang memimpin pencarian.",
   "emo": "tenang"
  },
  {
   "id": "N5",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    19.54,
    22.22
   ],
   "dst": 62.07,
   "dur": 2.68,
   "text": "Malamnya, kami nemuin Pak RT di pos ronda.",
   "emo": "tegas"
  },
  {
   "id": "R1",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    0.0,
    4.54
   ],
   "dst": 67.75,
   "dur": 4.54,
   "text": "Tiga hari kami cari Melati. Sekampung ikut. Nggak ketemu.",
   "emo": "serius"
  },
  {
   "id": "R2",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    5.25,
    16.58
   ],
   "dst": 72.69,
   "dur": 11.33,
   "text": "Malam ketiga, warga dengar suara ketawa dari kamar empat. Pintunya terkunci dari dalam. Kami dobrak... kosong. Cuma lampu hijau yang nyala sendiri.",
   "emo": "serius"
  },
  {
   "id": "P1",
   "spk": "pakronda",
   "file": "audio/pakronda.mp3",
   "src": [
    0.0,
    7.0
   ],
   "dst": 84.62,
   "dur": 7.0,
   "text": "Sejak malam itu, tiap jam tiga pagi ada baju putih di jemuran. Padahal nggak ada yang jemur.",
   "emo": "takut"
  },
  {
   "id": "N6",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    22.69,
    26.98
   ],
   "dst": 92.02,
   "dur": 4.29,
   "text": "Terkunci dari dalam? Terus dia keluarnya lewat mana, Pak?",
   "emo": "bingung"
  },
  {
   "id": "R3",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    17.37,
    21.56
   ],
   "dst": 96.71,
   "dur": 4.19,
   "text": "Nggak ada yang tahu, Nak. Tapi Melati bukan yang pertama.",
   "emo": "serius"
  },
  {
   "id": "R4",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    22.22,
    28.31
   ],
   "dst": 101.9,
   "dur": 6.09,
   "text": "Ratna, dua ribu dua belas. Sinta, dua ribu lima. Semuanya penghuni kamar empat.",
   "emo": "serius"
  },
  {
   "id": "N7",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    27.48,
    30.95
   ],
   "dst": 108.39,
   "dur": 3.47,
   "text": "Ratna... Sinta... Melati... semuanya penghuni kamar empat?",
   "emo": "takut"
  },
  {
   "id": "D1",
   "spk": "dimas",
   "file": "audio/dimas.mp3",
   "src": [
    0.0,
    5.64
   ],
   "dst": 112.36,
   "dur": 5.64,
   "text": "Dua ribu lima... dua ribu dua belas... dua ribu sembilan belas... tiap tujuh tahun.",
   "emo": "takut"
  },
  {
   "id": "D2",
   "spk": "dimas",
   "file": "audio/dimas.mp3",
   "src": [
    6.13,
    7.71
   ],
   "dst": 118.3,
   "dur": 1.58,
   "text": "Berarti... tahun ini?",
   "emo": "takut"
  },
  {
   "id": "A2",
   "spk": "adel",
   "file": "audio/adel.mp3",
   "src": [
    3.67,
    6.67
   ],
   "dst": 122.48,
   "dur": 3.0,
   "text": "Tinta di halaman ini... masih basah.",
   "emo": "takut"
  },
  {
   "id": "N8",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    31.43,
    32.85
   ],
   "dst": 127.68,
   "dur": 1.42,
   "text": "Itu... nama aku.",
   "emo": "beku"
  },
  {
   "id": "R5",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    28.92,
    30.75
   ],
   "dst": 129.9,
   "dur": 1.83,
   "text": "Ini... bukan tulisan saya.",
   "emo": "takut"
  },
  {
   "id": "N9",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    33.46,
    35.34
   ],
   "dst": 135.93,
   "dur": 1.88,
   "text": "Aku tinggal di kamar tiga... kan?",
   "emo": "beku"
  },
