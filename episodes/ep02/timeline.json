 "clips": [
  {
   "id": "N1",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    0.18,
    5.31
   ],
   "dst": 0.3,
   "dur": 5.13,
   "text": "Ssst... jangan berisik. Udah jam dua pagi... dan lampu itu nyala lagi.",
   "emo": "cemas"
  },
  {
   "id": "N2",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    5.9,
    7.9
   ],
   "dst": 5.93,
   "dur": 2.0,
   "text": "Kalian harus tahu ceritanya dari awal.",
   "emo": "cemas"
  },
  {
   "id": "N3",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    8.35,
    20.57
   ],
   "dst": 8.93,
   "dur": 12.22,
   "text": "Jadi, kos aku ini isinya empat kamar, nyambung sama rumah Ibu Kos. Kamar satu, Dimas. Kamar dua, Adel. Kamar tiga, aku. Kamar empat? Kosong dari zaman aku pertama masuk.",
   "emo": "ceria"
  },
  {
   "id": "N4",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    21.06,
    24.24
   ],
   "dst": 21.65,
   "dur": 3.18,
   "text": "Sampai minggu lalu... tiba-tiba ada penghuni baru.",
   "emo": "penasaran"
  },
  {
   "id": "N5",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    24.61,
    32.68
   ],
   "dst": 26.03,
   "dur": 8.07,
   "text": "Anehnya, dia nggak pernah keluar siang hari. Nggak pernah. Keluarnya cuma tengah malam, pas semua orang udah tidur.",
   "emo": "curiga"
  },
  {
   "id": "N6",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    33.06,
    36.64
   ],
   "dst": 34.7,
   "dur": 3.58,
   "text": "Terus tiap malam, lampu kamarnya kedip-kedip... warna hijau.",
   "emo": "cemas"
  },
  {
   "id": "N7",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    36.97,
    40.7
   ],
   "dst": 38.98,
   "dur": 3.73,
   "text": "Oke... mungkin dia kerja shift malam. Atau mungkin dia cuma pemalu banget.",
   "emo": "mikir"
  },
  {
   "id": "N8",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    41.08,
    46.38
   ],
   "dst": 43.71,
   "dur": 5.3,
   "text": "Tapi jam tiga pagi, ada baju putih panjang dijemur. Siapa yang nyuci baju jam segitu?",
   "emo": "bingung"
  },
  {
   "id": "N9",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    46.71,
    51.12
   ],
   "dst": 49.71,
   "dur": 4.41,
   "text": "Kamarnya juga wangi bunga melati. Ya... mungkin parfumnya emang melati.",
   "emo": "penasaran"
  },
  {
   "id": "K1",
   "spk": "kunti",
   "file": "audio/kunti.mp3",
   "src": [
    0.0,
    1.24
   ],
   "dst": 54.72,
   "dur": 1.24,
   "text": "",
   "emo": ""
  },
  {
