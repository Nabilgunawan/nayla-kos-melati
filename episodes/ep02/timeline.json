   "file": "audio/nayla.mp3",
   "src": [
    51.42,
    57.06
   ],
   "dst": 56.36,
   "dur": 5.64,
   "text": "Dan tiap malam ada suara ketawa pelan. Mungkin dia lagi nonton video lucu. Mungkin.",
   "emo": "cemas"
  },
  {
   "id": "N11",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    57.35,
    59.72
   ],
   "dst": 62.7,
   "dur": 2.37,
   "text": "Oke. Malam ini aku mau kenalan langsung.",
   "emo": "tegas"
  },
  {
   "id": "N12",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
