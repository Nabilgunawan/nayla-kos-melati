{
 "total": 195.2,
 "clips": [
  {
   "id": "N1",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    0.16,
    6.39
   ],
   "dst": 0.6,
   "dur": 6.23,
   "text": "Malam ini, kami semua kumpul di pos ronda. Pak RT janji mau cerita... semuanya.",
   "emo": "cemas"
  },
  {
   "id": "R1",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    0.0,
    4.89
   ],
   "dst": 7.63,
   "dur": 4.89,
   "text": "Melati itu anak baik. Tiap pagi dia nyapa semua orang di gang ini.",
   "emo": "tenang"
  },
  {
   "id": "R2",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    5.4,
    10.41
   ],
   "dst": 12.92,
   "dur": 5.01,
   "text": "Dia kerja di pabrik sepatu di kota. Pulangnya sering bawain gorengan buat yang ronda.",
   "emo": "tenang"
  },
  {
   "id": "R3",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    10.92,
    14.56
   ],
   "dst": 18.33,
   "dur": 3.64,
   "text": "Kalau ada warga yang butuh bantuan, dia yang pertama datang.",
   "emo": "tenang"
  },
  {
   "id": "W1",
   "spk": "budarmi",
   "file": "audio/budarmi.mp3",
   "src": [
    0.16,
    7.44
   ],
   "dst": 24.97,
   "dur": 7.28,
   "text": "Saya masih inget, beberapa hari sebelum hilang, Melati beli lilin di warung saya. Banyak banget.",
   "emo": "cemas"
  },
  {
   "id": "R4",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    15.09,
    22.03
   ],
   "dst": 33.25,
   "dur": 6.94,
   "text": "Sampai suatu malam... lampu kamarnya kedip-kedip sendiri. Hijau. Nggak berhenti-berhenti.",
   "emo": "serius"
  },
  {
   "id": "R5",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    22.52,
    26.08
   ],
   "dst": 40.59,
   "dur": 3.56,
   "text": "Kami ketuk, nggak ada jawaban. Akhirnya kami dobrak.",
   "emo": "serius"
  },
  {
   "id": "R6",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    26.6,
    31.78
   ],
   "dst": 45.35,
   "dur": 5.18,
   "text": "Kamarnya berantakan. Kasurnya terbalik. Tapi Melati... nggak ada.",
   "emo": "sedih"
  },
  {
   "id": "R7",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    32.25,
    38.18
   ],
   "dst": 51.53,
   "dur": 5.93,
   "text": "Tiga hari tiga malam, sekampung nyari. Sampai ke sawah, ke kebun, ke sungai.",
   "emo": "serius"
  },
  {
   "id": "R8",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    38.67,
    44.7
   ],
   "dst": 58.06,
   "dur": 6.03,
   "text": "Di pinggir sungai, kami nemuin sepatu dan tasnya. Cuma itu. Nggak ada jejak lain.",
   "emo": "sedih"
  },
  {
   "id": "R9",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    45.16,
    50.11
   ],
   "dst": 64.89,
   "dur": 4.95,
   "text": "Kami nggak percaya dia pergi begitu aja. Jadi kami minta tolong seorang detektif.",
   "emo": "serius"
  },
  {
   "id": "T1",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    0.0,
    3.51
   ],
   "dst": 70.64,
   "dur": 3.51,
   "text": "Saya mulai dari tempat terakhir dia terlihat. Kamarnya.",
   "emo": "serius"
  },
  {
   "id": "T2",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    3.96,
    11.82
   ],
   "dst": 74.75,
   "dur": 7.86,
   "text": "Pintu dikunci dari dalam. Jendela juga. Tapi lihat ini... bekas lilin, melingkar di lantai. Dan abu kemenyan di sudut.",
   "emo": "serius"
  },
  {
   "id": "T3",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    12.25,
    13.95
   ],
   "dst": 83.41,
   "dur": 1.7,
   "text": "Berikutnya, tempat kerjanya.",
   "emo": "mikir"
  },
  {
   "id": "RN1",
   "spk": "rina",
   "file": "audio/rina.mp3",
   "src": [
    0.2,
    9.47
   ],
   "dst": 85.91,
   "dur": 9.27,
   "text": "Melati seneng banget waktu itu. Katanya ada yang ngasih sepatu merah, cantik banget. Tapi dia nggak tahu dari siapa.",
   "emo": "sedih"
  },
  {
   "id": "T4",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    14.3,
    18.87
   ],
   "dst": 95.68,
   "dur": 4.57,
   "text": "Sepatu yang ditemukan di sungai... bukan sepatu kerjanya. Itu sepatu hadiah itu.",
   "emo": "kaget"
  },
  {
   "id": "W2",
   "spk": "budarmi",
   "file": "audio/budarmi.mp3",
   "src": [
    8.25,
    13.26
   ],
   "dst": 101.45,
   "dur": 5.01,
   "text": "Katanya dia disuruh beliin sama seseorang, Pak. Tapi dia nggak bilang siapa.",
   "emo": "cemas"
  },
  {
   "id": "T5",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    19.23,
    24.43
   ],
   "dst": 107.66,
   "dur": 5.2,
   "text": "Sepatu ini disusun rapi, berdampingan. Orang yang hanyut nggak melepas sepatunya serapi ini.",
   "emo": "serius"
  },
  {
   "id": "T6",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    24.82,
    28.6
   ],
   "dst": 113.26,
   "dur": 3.78,
   "text": "Sisa kemenyan dan bunga tujuh rupa. Ini bukan hilang biasa.",
   "emo": "serius"
  },
  {
   "id": "T7",
   "spk": "detektif",
   "file": "audio/detektif.mp3",
   "src": [
    28.91,
    33.13
   ],
   "dst": 117.64,
   "dur": 4.22,
   "text": "Kemenyan nggak dijual di warung kampung. Cuma ada satu lapak... di pasar.",
   "emo": "mikir"
  },
  {
   "id": "S1",
   "spk": "sarip",
   "file": "audio/sarip.mp3",
   "src": [
    0.0,
    7.69
   ],
   "dst": 123.46,
   "dur": 7.69,
   "text": "Yang beli kemenyan minggu itu orang kampung situ, Pak. Pakai sarung, mukanya ditutup. Jalannya... ke arah hutan bambu.",
   "emo": "takut"
  },
  {
   "id": "R10",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    50.67,
    54.33
   ],
   "dst": 135.75,
   "dur": 3.66,
   "text": "Detektif itu nemuin sesuatu yang nggak pernah kami duga.",
   "emo": "serius"
  },
  {
   "id": "R11",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    54.78,
    57.65
   ],
   "dst": 139.81,
   "dur": 2.87,
   "text": "Melati... diduga jadi tumbal pesugihan.",
   "emo": "serius"
  },
  {
   "id": "N2",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    7.17,
    9.78
   ],
   "dst": 143.08,
   "dur": 2.61,
   "text": "Tumbal...? Maksudnya... dikorbankan?",
   "emo": "takut"
  },
  {
   "id": "D1",
   "spk": "dimas",
   "file": "audio/dimas.mp3",
   "src": [
    0.2,
    2.9
   ],
   "dst": 145.99,
   "dur": 2.7,
   "text": "Pak... tumbal itu buat apa?",
   "emo": "takut"
  },
  {
   "id": "R12",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    58.09,
    62.84
   ],
   "dst": 149.09,
   "dur": 4.75,
   "text": "Orang yang pengin kaya lewat jalan gelap. Gantinya... nyawa orang lain.",
   "emo": "serius"
  },
  {
   "id": "A1",
   "spk": "adel",
   "file": "audio/adel.mp3",
   "src": [
    0.0,
    2.73
   ],
   "dst": 154.34,
   "dur": 2.73,
   "text": "Terus, Pak... dukunnya ketemu?",
   "emo": "takut"
  },
  {
   "id": "R13",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    63.32,
    66.08
   ],
   "dst": 157.47,
   "dur": 2.76,
   "text": "Ketemu. Di gubuk, di ujung hutan bambu.",
   "emo": "serius"
  },
  {
   "id": "M1",
   "spk": "mbahkarto",
   "file": "audio/mbahkarto.mp3",
   "src": [
    0.0,
    4.85
   ],
   "dst": 162.63,
   "dur": 4.85,
   "text": "Saya cuma perantara... Yang minta, bukan saya.",
   "emo": "seram"
  },
  {
   "id": "M2",
   "spk": "mbahkarto",
   "file": "audio/mbahkarto.mp3",
   "src": [
    5.47,
    11.52
   ],
   "dst": 167.98,
   "dur": 6.05,
   "text": "Orangnya... selalu dekat dengan korbannya. Tiap tujuh tahun... dia butuh lagi.",
   "emo": "seram"
  },
  {
   "id": "R14",
   "spk": "pakrt",
   "file": "audio/pakrt.mp3",
   "src": [
    66.46,
    72.43
   ],
   "dst": 174.83,
   "dur": 5.97,
   "text": "Dukunnya ketemu. Tapi orang yang minta pesugihan itu... sampai sekarang belum ketahuan.",
   "emo": "serius"
  },
  {
   "id": "N3",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    10.27,
    13.38
   ],
   "dst": 186.4,
   "dur": 3.11,
   "text": "Tiap tujuh tahun... berarti... tahun ini.",
   "emo": "takut"
  },
  {
   "id": "N4",
   "spk": "nayla",
   "file": "audio/nayla.mp3",
   "src": [
    13.88,
    15.18
   ],
   "dst": 190.31,
   "dur": 1.3,
   "text": "Dekat dengan korbannya...?",
   "emo": "beku"
  },
  {
   "id": "K1",
   "spk": "kunti",
   "file": "audio/kunti.mp3",
   "src": [
    4.98,
    5.58
   ],
   "dst": 193.01,
   "dur": 0.6,
   "text": "",
   "emo": ""
  }
 ],
